{
  "name": "Topic 12 - Production Error Monitoring",
  "nodes": [
    {
      "parameters": {},
      "id": "384d6fed-fe89-4bcc-b40a-242d407158a6",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -720,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst execution = e.execution || {};\nconst workflow = e.workflow || {};\nconst message = e.error?.message || execution.error?.message || e.message || 'Unknown workflow failure';\nreturn [{json:{event:'workflow_failure',timestamp:new Date().toISOString(),workflow_name:workflow.name || e.workflow_name || 'unknown',workflow_id:workflow.id || e.workflow_id || 'unknown',execution_id:execution.id || e.execution_id || 'unknown',last_node:execution.lastNodeExecuted || e.last_node || 'unknown',error_message:String(message).slice(0,1000),execution_url:execution.url || '',severity:'high'}}];"
      },
      "id": "13c44db3-78af-425e-80ab-d2458a4c4633",
      "name": "Normalize Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "e08850e1-83ed-40a4-bb5e-2a6c20eae8cf",
              "leftValue": "={{ $json.monitoring_webhook_url || \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8a9901fd-b1a0-4880-99a7-694c2e8c8143",
      "name": "Slack Webhook Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -240,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MONITORING_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({text: \"n8n failure: \" + $json.workflow_name + \" | \" + $json.error_message + \" | Execution: \" + $json.execution_id}) }}",
